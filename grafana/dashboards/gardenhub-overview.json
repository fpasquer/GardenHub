      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "gardenhub-mysql"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  m.measured_at AS `time`,\n  m.value,\n  CONCAT(d.name, ' · ', s.type) AS metric\nFROM measurement m\nJOIN sensor s ON s.id = m.sensor_id\nJOIN device d ON d.id = s.device_id\nWHERE $__timeFilter(m.measured_at)\n  AND s.type = 'soil_moisture'\nORDER BY m.measured_at",
          "refId": "A"
        }
      ],
      "title": "Soil moisture",
      "type": "stat"
