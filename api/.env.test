# Dummy, non-secret values loaded automatically when APP_ENV=test.
# The when@test service override in services.yaml swaps the real
# transport for FakeTelegramTransport, so these are never used to make
# a real network call — they only exercise the enabled/configured path.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=test-token
TELEGRAM_CHAT_ID=test-chat
TELEGRAM_MIN_LEVEL=warning
